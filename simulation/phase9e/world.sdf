<?xml version="1.0"?>
<sdf version="1.9">
  <world name="phase9e">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.7 0.7 0.7 1</background></scene>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -1</direction></light>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
      </link>
    </model>
    <model name="phase9c_robot">
      <pose>0 0 0.16 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>4</mass><inertia><ixx>0.08</ixx><iyy>0.1</iyy><izz>0.15</izz></inertia></inertial>
        <collision name="base_collision"><geometry><box><size>0.6 0.4 0.15</size></box></geometry></collision>
        <visual name="base_visual"><geometry><box><size>0.6 0.4 0.15</size></box></geometry></visual>
      </link>
      <link name="left_wheel">
        <pose>0.15 0.25 -0.06 -1.57079632679 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.0015</ixx><iyy>0.0015</iyy><izz>0.0025</izz></inertia></inertial>
        <collision name="left_collision"><geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry></collision>
        <visual name="left_visual"><geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry></visual>
      </link>
      <link name="right_wheel">
        <pose>0.15 -0.25 -0.06 -1.57079632679 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.0015</ixx><iyy>0.0015</iyy><izz>0.0025</izz></inertia></inertial>
        <collision name="right_collision"><geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry></collision>
        <visual name="right_visual"><geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry></visual>
      </link>
      <link name="caster">
        <pose>-0.22 0 -0.11 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="caster_collision"><geometry><sphere><radius>0.05</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
      </link>
      <link name="lidar_link"><pose>0.1 0 0.22 0 0 0</pose>
        <sensor name="lidar" type="gpu_lidar"><always_on>true</always_on><update_rate>10</update_rate><topic>/scan</topic><gz_frame_id>lidar_link</gz_frame_id>
          <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle></horizontal></scan><range><min>0.1</min><max>12</max><resolution>0.01</resolution></range></lidar>
        </sensor>
      </link>
      <link name="camera_link"><pose>0.25 0 0.22 0 0 0</pose>
        <sensor name="camera" type="camera"><always_on>true</always_on><update_rate>5</update_rate><topic>/camera/image_raw</topic><gz_frame_id>camera_link</gz_frame_id>
          <camera><horizontal_fov>1.3</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.1</near><far>20</far></clip><camera_info_topic>/camera/camera_info</camera_info_topic></camera>
        </sensor>
      </link>
      <joint name="lidar_fixed" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>
      <joint name="camera_fixed" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>
      <joint name="left_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 0 1</xyz></axis></joint>
      <joint name="right_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 0 1</xyz></axis></joint>
      <joint name="caster_joint" type="ball"><parent>base_link</parent><child>caster</child></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_joint</left_joint><right_joint>right_joint</right_joint>
        <wheel_separation>0.5</wheel_separation><wheel_radius>0.1</wheel_radius>
        <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
    <model name="red_box"><static>true</static><pose>3 0 0.5 0 0 0</pose><link name="box"><collision name="collision"><geometry><box><size>0.6 0.6 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.6 0.6 1</size></box></geometry><material><ambient>0.8 0.02 0.02 1</ambient><diffuse>0.9 0.03 0.03 1</diffuse></material></visual></link></model>
    <model name="blue_cylinder"><static>true</static><pose>3 2 0.5 0 0 0</pose><link name="cylinder"><collision name="collision"><geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry><material><ambient>0.02 0.02 0.8 1</ambient><diffuse>0.03 0.03 0.9 1</diffuse></material></visual></link></model>
    <model name="wall_north"><static>true</static><pose>0 9.9 0.5 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>20 0.2 1</size></box></geometry></collision></link></model>
    <model name="wall_south"><static>true</static><pose>0 -9.9 0.5 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>20 0.2 1</size></box></geometry></collision></link></model>
    <model name="wall_east"><static>true</static><pose>9.9 0 0.5 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>0.2 20 1</size></box></geometry></collision></link></model>
    <model name="wall_west"><static>true</static><pose>-9.9 0 0.5 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>0.2 20 1</size></box></geometry></collision></link></model>
  </world>
</sdf>
