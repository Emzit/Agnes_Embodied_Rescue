import fs from 'node:fs';
import {createClient,memoryJournal} from '../../third_party/agnes-harness/packages/sdk/src/index.node.ts';
const R='/data-ssd/zhongchengkai/agnes';if(process.cwd()!==R)throw Error('WORKSPACE_REQUIRED');
const O=JSON.parse(fs.readFileSync(R+'/artifacts/demo-video/autonomous-supplement-current.json','utf8')).directory,plan=JSON.parse(fs.readFileSync(O+'/supplement-plan.json','utf8'));
const owner=JSON.parse(fs.readFileSync(R+'/.agh-home-step7/data/daemon/owner.json','utf8'));const c=createClient({transport:{kind:'unix',path:owner.socketPath},auth:{kind:'local'},journal:memoryJournal()});
let session:any,reader:any,iterator:any;const calls=new Map();const append=(f:string,v:any)=>fs.appendFileSync(O+'/'+f,JSON.stringify(v)+'\n');
const text='补充任务：继续当前现场，不要复位或改动其他门。请先在当前右前方房门附近调整视角，使用新相机观测确认 Right_Front_Door；检查失败时重新对准门，不得跳过视觉检查。确认可操作后打开 Right_Front_Door，检查实际开门终态；进入 Right_Front_Room，接近刚才确认的待救援人员，在安全距离停下，并用新的相机画面复核人员。只有完成开门、进入、接近和停止后才结束；找到人员或标记 found 不能代替这些动作。保持同一个会话，不开启全楼搜索。';
try{await c.initialize();session=await c.session.load(plan.session_id,{cwd:R,onPermissionRequest:async(req:any)=>{const name=String(req.toolCall?.title??'').split(' ')[0];const allowed=/^(?:mcp_(?:robot_mcp|envdoor)_[^_]+_(?:get_robot_state|get_observation|get_world_state|get_map|list_known_locations|navigate_to|inspect_object|inspect_room|inspect_door|open_door|stop_robot)|mission_get_state|world_memory_get|world_memory_update|mission_reset|decision_score_candidates)$/.test(name);append('permissions.jsonl',{at:new Date().toISOString(),name,allowed,basis:plan.human_authorization});return{verdict:allowed?'allowed-once':'rejected'};}});await session.attach();
 iterator=session.events()[Symbol.asyncIterator]();reader=(async()=>{for(;;){const n=await iterator.next();if(n.done)break;const e=n.value;append('native-events.jsonl',e);if(e.type==='tool/call')calls.set(e.data.toolUseId,{name:e.data.name,args:e.data.args});if(e.type==='tool/result')append('native-tool-results.jsonl',{at:new Date().toISOString(),...calls.get(e.data.toolUseId),data:e.data});}})();
 fs.writeFileSync(O+'/actual-followup-prompt.txt',text);fs.writeFileSync(O+'/started.json',JSON.stringify({at:new Date().toISOString(),session_id:session.id,prompt:text,user_authorized_supplement:true,phase1_sdk_prompt:false,phase2_sdk_prompt:true,scene_reset:false},null,2));
 const observe=setInterval(()=>{try{append('ros-observer.jsonl',{at:new Date().toISOString(),state:JSON.parse(fs.readFileSync(R+'/artifacts/demo-ui-final/ros-state.json','utf8'))});}catch{}},500);
 try{const turn=await session.prompt(text);fs.writeFileSync(O+'/turn-result.json',JSON.stringify({at:new Date().toISOString(),turn},null,2));console.log(JSON.stringify(turn));}finally{clearInterval(observe);}
}catch(e:any){fs.writeFileSync(O+'/failure.json',JSON.stringify({at:new Date().toISOString(),message:e.message},null,2));console.error(e);process.exitCode=1;}
finally{await iterator?.return?.();await reader?.catch(()=>{});await session?.detach();await c.close();}
