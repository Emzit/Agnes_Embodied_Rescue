{
  "name": "embodied-rescue-plugin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Plugin-first interfaces and mock logic for embodied rescue missions.",
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./backend": "./src/backend/index.ts",
    "./decision": "./src/decision/provider.ts",
    "./robot": "./src/robot/client.ts"
  },
  "agnes": {
    "plugins": [
      {
        "export": "embodiedRescuePlugin",
        "id": "ext:local/embodied-rescue-plugin/backend",
        "inject": ["extension"]
      },
      {
        "export": "embodiedRescueSkills",
        "id": "ext:local/embodied-rescue-plugin/skills",
        "inject": ["skills"]
      }
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts"
  }
}
